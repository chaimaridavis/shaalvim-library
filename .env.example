# Copy this file to .env.local and fill in the values. Never commit .env.local.
# The same four settings go into Vercel: Project > Settings > Environment Variables.

# Supabase: Project Settings > Data API (Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase: Project Settings > API Keys > Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase: Project Settings > API Keys > Secret key. Keep private.
SUPABASE_SECRET_KEY=

# The email address of the library's administrator.
ADMIN_EMAIL=
